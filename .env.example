# Public, non-secret API origin. Required at Docker/Vercel build time because Next.js
# embeds NEXT_PUBLIC_* values in browser bundles; also set it at runtime for SSR.
NEXT_PUBLIC_API_URL=https://apicbmradio.cbmgroupco.com

# Optional public station stream and newsletter signup URLs.
NEXT_PUBLIC_RADIO_STREAM_URL=https://c22.radioboss.fm:8538/stream
NEXT_PUBLIC_NEWSLETTER_URL=

# Build-time hostname allowlist entry for the HTTPS media/CDN domain.
# Supply the hostname only, without scheme or path.
MEDIA_HOSTNAME=apicbmradio.cbmgroupco.com
