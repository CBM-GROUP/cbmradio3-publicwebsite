# Public, non-secret API origin. Required at Docker build time because Next.js
# embeds NEXT_PUBLIC_* values in browser bundles; also set it at runtime for SSR.
NEXT_PUBLIC_API_URL=http://localhost:8002

# Build-time hostname allowlist entry for the HTTPS CloudFront media domain.
# Supply the hostname only, without scheme or path.
MEDIA_HOSTNAME=media.cbmradio.example
